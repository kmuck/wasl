// Target program of WaSL v0.4 (docs/spec_v0.4, § 15.7): a command-line program for
// WASI 0.3, run with `weasel run hello`. Its entry point is `wasi:cli/run`, an async
// function of WASI implemented in the world (§ 2.4.2, § 2.8). It writes on the standard
// output through a stream, then waits until the standard output is done.

world hello {
  import wasi:cli/types;
  import wasi:cli/stdout;

  export wasi:cli/run {
    async func run() -> result {
      local (rx: stream<u8>, tx: stream_writer<u8>) = stream.new();
      local done: future<result<_, types::error_code>> = stdout::write_via_stream(rx);
      stream.write(tx, string.bytes(greeting::text("world")));
      stream.close(tx);
      match (future.read(done)) {
        case ok {
          return result.ok;
        }
        case err {
          return result.err;
        }
      }
    }
  }
}

interface greeting {
  func text(name: string) -> string {
    return "Hello, " + name + "!\n";
  }
}
